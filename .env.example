# Notelify AI -- environment variables
# Copy to .env and fill in real values. Never commit the real .env file.

# ---- Phase 0 (used now) ----------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres (used by both the docker-compose "postgres" service and the
# backend's DATABASE_URL below -- keep these consistent with each other).
POSTGRES_USER=notelify
POSTGRES_PASSWORD=notelify_dev_password
POSTGRES_DB=notelify
POSTGRES_PORT=5432

# Backend's view of the database above. Async driver (asyncpg) for the app;
# Alembic swaps this to the sync "psycopg" driver itself (app/config.py).
DATABASE_URL=postgresql+asyncpg://notelify:notelify_dev_password@postgres:5432/notelify

# Comma-separated list of origins the API will accept credentialed requests
# from (docs/05-API-CONTRACTS.md §A.2). The Vite dev server's default port.
CORS_ALLOWED_ORIGINS=http://localhost:5173

BACKEND_PORT=8000

# ---- Dashboard (Vite, compile-time) ----------------------------------------
# See dashboard/.env.example -- VITE_-prefixed variables are baked in at
# build time, so they live in their own file, not here.

# ---- Phase 1 -- Authentication (NOT YET USED, placeholders only) ----------
# JWT_SIGNING_KEY=
# JWT_ISS=
# JWT_AUD=
# ACCESS_TOKEN_LIFETIME_MINUTES=      # proposed 15 -- see 05-API-CONTRACTS.md §B.1
# REFRESH_TOKEN_LIFETIME_DAYS=        # proposed 30
# REFRESH_GRACE_WINDOW_SECONDS=       # proposed 10
# REFRESH_GRACE_ENCRYPTION_KEY=       # AES-256-GCM key for grace_ciphertext, see 05 §A.3
